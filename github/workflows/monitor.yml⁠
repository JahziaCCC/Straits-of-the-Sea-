name: Straits of the Sea Monitor

on:
  schedule:
    # يعمل كل 15 دقيقة
    - cron: '*/15 * * * *'
  workflow_dispatch: # للسماح بالتجميع والتشغيل اليدوي للاختبار

jobs:
  build-and-run:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v3

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-stream: '3.10'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt

    - name: Run Monitoring Script
      env:
        TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
        TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
      run: python main.py

    - name: Commit and push changes to history
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action Bot"
        git add sent_posts.json
        git commit -m "Update sent posts history [skip ci]" || exit 0
        git push
